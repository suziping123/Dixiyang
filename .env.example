# ========================
# Dixiyang 环境变量配置
# ========================
# 复制此文件为 .env 并填入你自己的值：
#   cp .env.example .env
# 或直接运行一键部署脚本（会问你要 DeepSeek Key）：
#   ./scripts/deploy-linux.sh

# --- 数据库（MySQL）---
# 注意：生产环境请改成随机强密码；密码只建议用字母/数字，避免 @ : / ? # 等 URL 保留字符。
DB_USERNAME=root
DB_PASSWORD=your_password_here
# 本机原生开发用 127.0.0.1；Docker Compose 部署会自动覆盖为容器内的 db 主机。
DATABASE_URL=mysql+pymysql://root:your_password_here@127.0.0.1:3306/dixiyang?charset=utf8

# --- Docker Compose 部署参数（可选，不填用默认值）---
DB_NAME=dixiyang
WEB_PORT=8080
BACKEND_PORT=8084
REDIS_PASSWORD=123321
# 首次部署自动创建的管理员（登录后请尽快修改密码）
ADMIN_USERNAME=admin123
ADMIN_PASSWORD=123456
# 国内网络构建慢时取消注释（二选一）：
# NPM_REGISTRY=https://registry.npmmirror.com
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# --- 邮件（QQ SMTP，可选；注册/改邮箱验证码用）---
# 代码读取的是 SMTP_* 变量
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=587
# SMTP_USERNAME=your-qq-number@qq.com
# SMTP_PASSWORD=your-smtp-authorization-code

# --- JWT 密钥（必须）---
# 生成方法：openssl rand -hex 32
JWT_SECRET_KEY=your-secret-key-here

# --- DeepSeek API（必须，以下任一即可）---
# 从 https://platform.deepseek.com 获取
DEEPSEEK_API_KEY=sk-your-api-key-here
# DS_API_KEY=sk-your-api-key-here

# --- 可选：RAG 服务（8085，独立启动，不启动不影响主站）---
# Docker 部署时主后端默认通过 host.docker.internal 访问宿主机 RAG
# RAG_SERVICE_URL=http://host.docker.internal:8085
# RERANKER_URL=http://host.docker.internal:8085
# CHROMA_PERSIST_DIR=./storage/vectordb_4060
# CHROMA_COLLECTION_NAME=dixiyang_knowledge

# --- 可选：原生开发路径覆盖（Docker 部署会自动设置）---
# UPLOAD_DIR=./uploads
# STORAGE_DIR=./uploads/storage
# 注意：不要写成 .../storage/chat，代码会在它下面再拼 "chat/"
# CHAT_STORAGE_PATH=./uploads/storage
# RELOAD=1
